  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><size=24><color=#FFD700>DAYAKATTAM DUNGEON \u2014 THE SACRED DICE DUEL</color></size></b>\n\n<b>Cultural
    Heritage:</b> Based on the traditional Tamil board game <i>Thayam</i>, played
    for millennia during festive gatherings with two brass stick dice.\n\n<b>The
    'Lucky Number' Math:</b>\n\u2022 Two 4-sided oblong brass sticks (faces: 0, 1,
    2, 3).\n\u2022 Normal sum: 1..6. But rolling <b>0 + 0 = 12 (Pannirendu)!</b>\n\u2022
    <b>Lucky Numbers (1, 5, 6, 12):</b> Trigger an <i>Auspicious Streak</i>, granting
    +1 Extra Roll and accelerating your <i>Combo Multiplier</i> (1x -> 1.5x -> 2x
    -> 3x)!\n\u2022 Standard numbers (2, 3, 4) end your rolling streak and begin
    the Action Phase.\n\n<b>Tactical Board & Sanctuary:</b>\n\u2022 <b>Thayam Entry:</b>
    You must spend a <b>1 (Thayam)</b> to awaken a spirit pawn from reserve.\n\u2022
    <b>Malai (Safe Squares):</b> The 8 crossed perimeter tiles grant capture immunity.\n\u2022
    <b>Striking:</b> Landing on an opponent pawn on an unsafe tile cuts them back
    to their reserve!\n\n<b>Victory:</b> The first player to successfully navigate
    all 3 spirit pawns into the Central Palace wins the duel!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
